{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/hf-sync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/keeper",
      "schedule": "*/10 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "askswarm-nine.vercel.app"
        }
      ],
      "destination": "https://askswarm.evalengine.ai/:path",
      "permanent": false
    }
  ]
}
